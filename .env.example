# Copy to .env.local and fill in. Never commit .env.local.
# Used only for local WordPress REST. Writes are Trash-only when enabled.

WP_REST_BASE_URL=https://gradschool.wsu.edu
WP_REST_USERNAME=gcrouch
WP_REST_APPLICATION_PASSWORD=
WP_REST_ENABLED=1
# Local only. Allows Move to Trash via REST. Never set this on Vercel.
# Trash can be undone in WordPress. This app never force-deletes.
WP_REST_WRITE_ENABLED=0
