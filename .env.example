# Copy to .env.local and fill in. Never commit .env.local.
# APP_AUTH_USERS_JSON maps exact WSU emails to Werkzeug scrypt hashes.
# Generate each hash locally; never store an app user's plaintext password.
APP_AUTH_USERS_JSON={}
FLASK_SECRET_KEY=

WP_REST_BASE_URL=https://gradschool.wsu.edu
# WordPress username (not email) of a dedicated Editor-level account.
WP_REST_USERNAME=
# Created in WordPress under Users -> Profile -> Application Passwords.
# Shown once; revoke and recreate if lost. See README.md.
WP_REST_APPLICATION_PASSWORD=
WP_REST_ENABLED=1
# Trash can be undone in WordPress. This app never force-deletes.
WP_REST_WRITE_ENABLED=0
# Required in addition to WP_REST_WRITE_ENABLED for Vercel Production writes.
# Preview deployments remain read-only regardless of this setting.
WP_REST_REMOTE_WRITE_ENABLED=0
